{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kody-w/rapp-work/protocols/rapp-work-sdk/1/schema.json",
  "title": "RAPP Work SDK workspace integration record",
  "type": "object",
  "required": [
    "schema",
    "protocol",
    "profile",
    "workspace_rappid",
    "world_id",
    "sdk_version",
    "network_default",
    "execution_policy"
  ],
  "properties": {
    "schema": {
      "const": "rapp-work-sdk/1"
    },
    "protocol": {
      "const": "rapp-work/1"
    },
    "profile": {
      "const": "rapp-work-sdk/1"
    },
    "workspace_rappid": {
      "type": "string",
      "pattern": "^rappid:@[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}$"
    },
    "world_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "sdk_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "network_default": {
      "const": "disabled"
    },
    "execution_policy": {
      "const": "inert-discovery"
    }
  },
  "additionalProperties": false
}
